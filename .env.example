# App
APP_ENV=development
LOG_LEVEL=INFO
DEBUG=true

# Database (PostgreSQL)

POSTGRES_USER=docusign
POSTGRES_PASSWORD=change-me
POSTGRES_DB=docusign_master
DATABASE_URL=postgresql://docusign:change-me@localhost:5432/docusign_master
DB_POOL_SIZE=5

MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=docusign-documents
MINIO_SECURE=false
# MINIO_ROOT_USER=minioadmin
# MINIO_ROOT_PASSWORD=MinioDev@2006


# Sandbox auth server. Production would be account.docusign.com
DOCUSIGN_AUTH_SERVER=account-d.docusign.com
DOCUSIGN_INTEGRATION_KEY=your-integration-key-guid
DOCUSIGN_USER_ID=

# Path to the RSA private key used for JWT Grant (never commit this file)
DOCUSIGN_PRIVATE_KEY_PATH=./keys/docusign_private.pem
DOCUSIGN_REQUEST_TIMEOUT=30

# Rate limiting / pagination
DOCUSIGN_MAX_RETRIES_ON_429=10
DOCUSIGN_DEFAULT_RETRY_AFTER_SECONDS=30
DOCUSIGN_DEFAULT_PAGE_SIZE=100


#  Resilience (retry + dead-letter queue)
EXTERNAL_CALL_MAX_RETRIES=3
EXTERNAL_CALL_RETRY_DELAYS=1,2,5
EXTERNAL_CALL_JITTER=0.25
DLQ_PAYLOAD_MAX_BYTES=10000

# HMAC (Coordinator -> this service) 

# Generate each key with: python -c "import secrets; print(secrets.token_hex(32))"

HMAC_ENABLED=true
HMAC_SECRET_KEY_CORE=
HMAC_SECRET_KEY_ENGINEER=
HMAC_SIGNATURE_MAX_AGE=300

# Job tracking
JOB_HEARTBEAT_INTERVAL_SECONDS=30
JOB_CRASH_TIMEOUT_MINUTES=10

#  Optional encryption (Fernet) for secrets stored at rest

# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"

ENCRYPTION_KEY=
